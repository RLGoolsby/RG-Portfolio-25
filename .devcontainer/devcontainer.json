{
	"name": "Node.js Vite React TS & Bootstrap Dev Environment",
	// Pulls an official, optimized devcontainer image pre-bundled with Node.js and features like Git
	"image": "://microsoft.com",
	// Customizes features and settings inside the container
	"customizations": {
		"vscode": {
			"settings": {
				// Sets default Linux terminal in container
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"ms-vscode.vscode-typescript-next"
			]
		}
	},
	// Forwards Vite's default dev server port (5173) to your local host machine
	"forwardPorts": [
		5173
	],
	// Ensures container maps the port seamlessly to localhost:5173
	"portsAttributes": {
		"5173": {
			"label": "Vite Dev Server",
			"onAutoForward": "notify"
		}
	},
	// Automated script that runs right after the container is safely created
	"postCreateCommand": "npm install",
	// Ensures permissions align with the 'node' user inside the container image
	"remoteUser": "node"
}