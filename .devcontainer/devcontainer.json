{
	"name": "Node React TS Bootstrap Dev Environment",
	"image": "://microsoft.com",
	// Forward the local server port (React typically uses 3000 or 5173)
	"forwardPorts": [
		3000,
		5173
	],
	// Configure tool-specific properties inside the container
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"dsznajder.es7-react-js-snippets"
			]
		}
	},
	// Install system tools or packages if needed after the container is built
	"postCreateCommand": "npm install -g npm@latest"
}